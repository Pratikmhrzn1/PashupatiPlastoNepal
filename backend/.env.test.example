# Test environment (used by `npm run test:e2e`)
# Copy to `.env.test` and adjust to match your local Postgres.
NODE_ENV=test
PORT=4001
API_PREFIX=/api/v1

FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pashupati_plasto_test?schema=public

JWT_ACCESS_SECRET=test-access-secret-value-long-enough-here
JWT_REFRESH_SECRET=test-refresh-secret-value-long-enough-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

ADMIN_EMAIL=e2e-admin@example.com
ADMIN_PASSWORD=E2eAdminPass123!

RESEND_API_KEY=
MAIL_FROM=no-reply@example.com

ENABLE_TURNSTILE=false
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=1000
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_LIMIT=1000
MAIL_FROM_NAME=Pashupati Plasto
PASSWORD_RATE_LIMIT_TTL=900
PASSWORD_RATE_LIMIT_LIMIT=1000
VERIFICATION_RATE_LIMIT_TTL=900
VERIFICATION_RATE_LIMIT_LIMIT=1000
INQUIRY_RATE_LIMIT_TTL=600
INQUIRY_RATE_LIMIT_LIMIT=1000
INQUIRY_NOTIFY_EMAIL=
INQUIRY_AUTO_CONFIRM=false
FEATURED_PRODUCT_LIMIT=4
PUBLIC_PRODUCT_LIMIT=200
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
