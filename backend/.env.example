# App
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# CORS
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pashupati_plasto?schema=public

# Redis (optional)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Resend
RESEND_API_KEY=
MAIL_FROM=no-reply@example.com

# Security / Features
ENABLE_TURNSTILE=false
TURNSTILE_SECRET_KEY=
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Brute force protection
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_LIMIT=5
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000

# Mail
MAIL_FROM_NAME=Pashupati Plasto

# Password / verification rate limits
PASSWORD_RATE_LIMIT_TTL=900
PASSWORD_RATE_LIMIT_LIMIT=3
VERIFICATION_RATE_LIMIT_TTL=900
VERIFICATION_RATE_LIMIT_LIMIT=5

# Token lifetimes
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# Cache
CACHE_NAMESPACE=pashupati
PRODUCT_CACHE_TTL_SECONDS=60
PRODUCT_DETAIL_CACHE_TTL_SECONDS=300
