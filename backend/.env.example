# App
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Public web app origin. Used for CORS, email links and relative images.
# In a single Vercel project (same origin), this can match the deployment origin.
FRONTEND_URL=http://localhost:5173

# Extra allowed browser origins, comma-separated (e.g. Vercel preview URLs).
# The production origin above is always allowed.
CORS_ORIGINS=

# Cookies
# Use "none" when the web app and API live on different sites (e.g. two
# *.vercel.app domains). Use "lax" for same-origin single-project deployments.
COOKIE_SAME_SITE=lax

# Public origin of this API, used to build absolute URLs for uploaded images.
# Optional: falls back to the request's protocol/host (honouring proxy headers).
# BACKEND_PUBLIC_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pashupati_plasto?schema=public

# Redis (optional)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Admin seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Vercel Blob (product image uploads in production)
# Create a Blob store in the Vercel project and this token is injected automatically.
BLOB_READ_WRITE_TOKEN=

# Resend
RESEND_API_KEY=
MAIL_FROM=no-reply@example.com

# Security / Features
ENABLE_TURNSTILE=false
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_URL=
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Brute force protection
AUTH_RATE_LIMIT_TTL=60
AUTH_RATE_LIMIT_LIMIT=5
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MS=900000

# Mail
MAIL_FROM_NAME=Pashupati Plasto

# Password / verification rate limits
PASSWORD_RATE_LIMIT_TTL=900
PASSWORD_RATE_LIMIT_LIMIT=3
VERIFICATION_RATE_LIMIT_TTL=900
VERIFICATION_RATE_LIMIT_LIMIT=5

# Token lifetimes
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60

# Inquiries (contact form)
INQUIRY_RATE_LIMIT_TTL=600
INQUIRY_RATE_LIMIT_LIMIT=5
INQUIRY_NOTIFY_EMAIL=
INQUIRY_AUTO_CONFIRM=false

# Cache
CACHE_NAMESPACE=pashupati
PRODUCT_CACHE_TTL_SECONDS=60
PRODUCT_DETAIL_CACHE_TTL_SECONDS=300

# Public catalog
# Number of products returned by GET /api/products/featured
FEATURED_PRODUCT_LIMIT=4
# Maximum number of products returned by GET /api/products
PUBLIC_PRODUCT_LIMIT=200
