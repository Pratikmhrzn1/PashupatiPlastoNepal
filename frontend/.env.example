# API mode: "mock" (MSW intercepts /api) or "live" (real backend)
VITE_API_MODE=mock

# Base URL for the API when VITE_API_MODE=live.
# For same-origin single-project Vercel deployments, leave this unset.
# For local development, set to http://localhost:4000.
# For separate domains/projects, set to the full API origin.
# VITE_API_BASE_URL=http://localhost:4000
